# backguard-native:deps —— 本地容器镜像配方（pwsh7 + restic + age + borg + python3 + shellcheck）
#
# 用途：PS 逻辑测试与 shell E2E 的本地收敛（AGENTS §3「.ps1 的逻辑先在容器里收敛」）。
# 构建：docker build -f tools/Dockerfile.deps-image -t backguard-native:deps .
# 重试：apt（ports.ubuntu.com）偶发 502——重跑即可；curl 已带 --retry。
# 实测坑（10-04 重建三连踩，别再交学费）：
#   ①restic 资产名是**下划线**：restic_0.16.4_linux_arm64.bz2；
#     age 资产名是**连字符**：age-v1.1.1-linux-arm64.tar.gz——两家不同，写错即 404。
#   ②pwsh 必须装 libicu74，否则启动即 FailFast（Couldn't find a valid ICU package）。
#   ③arm64/amd64 由 dpkg --print-architecture 自适应，qemu 跨架构会 rc=139，别用。
FROM ubuntu:24.04
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3 python3-venv shellcheck git curl ca-certificates unzip bzip2 libicu74 borgbackup >/dev/null
RUN ARCH=$(dpkg --print-architecture) \
 && curl -fsSL --retry 5 --retry-delay 3 -o /tmp/pwsh.tar.gz "https://github.com/PowerShell/PowerShell/releases/download/v7.4.5/powershell-7.4.5-linux-${ARCH}.tar.gz" \
 && mkdir -p /opt/microsoft/powershell/7 && tar -xzf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
 && chmod +x /opt/microsoft/powershell/7/pwsh && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
 && rm /tmp/pwsh.tar.gz
RUN ARCH=$(dpkg --print-architecture) \
 && [ "$ARCH" = "arm64" ] && RA=linux_arm64 || RA=linux_amd64 \
 && curl -fsSL --retry 5 --retry-delay 3 -o /tmp/restic.bz2 "https://github.com/restic/restic/releases/download/v0.16.4/restic_0.16.4_${RA}.bz2" \
 && bzip2 -d /tmp/restic.bz2 && install -m 755 /tmp/restic /usr/bin/restic
RUN ARCH=$(dpkg --print-architecture) \
 && [ "$ARCH" = "arm64" ] && RA=linux-arm64 || RA=linux-amd64 \
 && curl -fsSL --retry 5 --retry-delay 3 -o /tmp/age.tar.gz "https://github.com/FiloSottile/age/releases/download/v1.1.1/age-v1.1.1-${RA}.tar.gz" \
 && tar -xzf /tmp/age.tar.gz -C /tmp age/age age/age-keygen \
 && install -m 755 /tmp/age/age /usr/local/bin/age && install -m 755 /tmp/age/age-keygen /usr/local/bin/age-keygen \
 && rm -rf /tmp/age*
